
*.log
/tmp/pyinstaller_build/
# Python - ignore the venv and PyInstaller's build/dist output entirely.
# python/dist/solver used to be tracked; it no longer is. go:embed reads
# bundled/<platform>/, and the build scripts COPY PyInstaller's output there,
# so python/dist/ is intermediate output with a tracked destination. It is
# also a 57-file --onedir tree now, not one binary.
build/bin
build/bin/
frontend/dist
goGearset
node_modules
python/__pycache__/
python/.venv/
python/*.pyc
# solver.spec is checked in on purpose — build-mac.sh/build-linux.sh/
# build-windows.ps1 all run `pyinstaller --noconfirm solver.spec`, and it must
# exist for a fresh clone to build at all. It lives under python/, which the
# rules here do not ignore wholesale, so no exception is needed — this note is
# just so nobody "tidies" it into python/dist/.
python/build/
python/dist/
# Leftover from the deleted runtime fetch (pre-0.5.0, ensureDDOBuilderData).
# The ETL reads the data/ddobuilder SUBMODULE instead — same bytes, but pinned,
# so a catalog can record the exact upstream revision it came from. Nothing
# writes these any more; the entries stay so an old working copy does not
# suddenly show up as untracked.
/DDOBuilderV2/
/DDOBuilderV2.download/
/.ddobuilderv2_commit
*.ddogearset
gearset_output.txt

test-pulp.lp

test_glpk.py

python/tests/__pycache__/

# Every __pycache__, wherever it appears — the per-directory rules above
# missed python/rules/ when that package was added.
__pycache__/

# Scratch dir used by scripts/capture_oracle.py while replaying gearsets
# through the solver. The captured fixtures themselves
# (python/tests/fixtures/oracle/*.oracle.json) ARE tracked on purpose — they are
# the differential oracle for the 0.5.0 recalculation work and cannot be
# regenerated once mode:"calculate" is removed. See
# docs/0.5.0/00_ETL_START_HERE.md Phase 0.
python/tests/fixtures/.capture_tmp/

frontend/wailsjs/runtime/package.json

frontend/wailsjs/runtime/runtime.d.ts

frontend/wailsjs/runtime/runtime.js

.DS_Store


# Full canonical parser output written by scripts/parser_snapshot.py.
# Only the digests file is tracked; this is the local diffing aid.
python/tests/fixtures/.snapshot_full/

# Runtime debris that must never reach a build: go:embed reads the FILESYSTEM,
# not git, so anything sitting in bundled/<platform>/ is compiled into the
# shipped binary whether or not it is tracked. SQLite's WAL sidecars appear
# any time something opens the bundled catalog read-write, and the solver
# writes its progress log into its working directory.
bundled/*/*.db-wal
bundled/*/*.db-shm
bundled/*/solver_progress.log

# dist/<platform>/ is a BUILD OUTPUT, not source: each build script wipes and
# repopulates its own subdirectory (`rm -rf "$DIST_DIR"`), so tracking it meant
# committing a fresh ~100 MB binary on every build for something git can never
# meaningfully diff. Anyone who needs the artefact builds it, or takes the
# archive package_release.sh writes to releases/.
#
# .gitkeep stays tracked so the directory's purpose survives in the repo —
# package_release.sh looks here, and the build scripts mkdir -p into it.
/dist/*
!/dist/.gitkeep
