FROM --platform=linux/amd64 golang:1.23-bullseye

# Install cross-compilation toolchain for Windows
RUN apt-get update && apt-get install -y curl \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y \
    gcc-mingw-w64-x86-64 \
    gcc-mingw-w64 \
    g++-mingw-w64-x86-64 \
    zip \
    nodejs \
    git \
    nsis \
    && rm -rf /var/lib/apt/lists/*

# Install Wails CLI
RUN go install github.com/wailsapp/wails/v2/cmd/wails@v2.10.0

WORKDIR /app
COPY . .

# Build for Windows
ENV CGO_ENABLED=1
ENV GOOS=windows
ENV GOARCH=amd64
ENV CC=x86_64-w64-mingw32-gcc
ENV CXX=x86_64-w64-mingw32-g++

RUN wails build -platform windows/amd64 -o DDOGearsetOptimizer.exe

CMD ["cp", "-r", "/app/build/bin/", "/output/"]
